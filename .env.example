# ─── API Server ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5435/equivalue
PORT=3001
NODE_ENV=development

# Allow requests from the Vite dev server
CORS_ORIGIN=http://localhost:5173

